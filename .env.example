# ==============================================================================
# LaunchWise AI — Environment Variables
# ==============================================================================

# Core Database (Defaults to SQLite for instant local zero-friction execution)
DATABASE_URL="sqlite:///./launchwise.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/launchwise"

# Optional External AI Engine Keys (Platform works in grounded demo mode if blank)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional Research Integrations
TAVILY_API_KEY=""
MAPS_API_KEY=""

# Set to True to force live network requests even if mock verified data exists
FORCE_LIVE_RESEARCH=False

# Frontend URL & CORS
NEXT_PUBLIC_API_URL=""
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "*"]
