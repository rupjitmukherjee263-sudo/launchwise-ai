# LaunchWise AI - Backend Environment Configuration

# Application
PROJECT_NAME="LaunchWise AI"
VERSION="1.0.0"

# Database (Default: SQLite for instant local zero-config development)
DATABASE_URL="sqlite:///./launchwise.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/launchwise"

# Optional External AI & Research APIs (Demo mode activates automatically if empty)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
TAVILY_API_KEY=""
MAPS_API_KEY=""

# Force Live External Calls (False = use defensive verified fixtures when keys omitted)
FORCE_LIVE_RESEARCH=False

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "*"]
